  dialogues:
  - "\u63A5\u4E0B\u6765\u6211\u5C06\u5E26\u4F60\u4E86\u89E3\u5982\u4F55\u73A9\u5B57\u6BCD\u724C"
  - "\u6E38\u620F\u5F88\u7B80\u5355\uFF0C\u6BCF5\u4E2A\u56DE\u5408\u8FDB\u884C\u4E00\u6B21\u5206\u6570\u5224\u5B9A"
  - "\u6B64\u5904\u7684\u6570\u5B57\u4E3A\u6BCF5\u4E2A\u56DE\u5408\u7ED3\u7B97\u65F6\u4F60\u9700\u8981\u8FBE\u5230\u7684\u5206\u6570"
  - "\u4E0A\u65B9\u7684\u6570\u5B57\u4E3A\u4F60\u5F53\u524D\u7684\u603B\u5206\u6570"
  - "\u8FD9\u91CC\u4E3A\u5F53\u524D\u56DE\u5408\u6570\uFF0C\u6BCF\u5F535\u56DE\u5408\u7ED3\u675F\u65F6\uFF0C\u8FDB\u884C\u5206\u6570\u5224\u5B9A"
  - "\u6BCF\u56DE\u5408\u5F00\u59CB\u65F6\u4F1A\u53D1\u4E24\u5F20\u5B57\u6BCD\u724C"
  - "\u70B9\u51FB\u5B57\u6BCD\u724C\u5373\u53EF\u5C06\u5176\u653E\u7F6E\u5230\u5F85\u51FA\u724C\u4F4D\u7F6E\uFF0C\u8BF7\u70B9\u51FB\u8FD9\u4E24\u5F20\u724C"
  - "\u70B9\u51FB\u51FA\u724C\u6309\u94AE\u5373\u53EF\u5C06\u5F85\u51FA\u724C\u4F4D\u7F6E\u7684\u5B57\u6BCD\u724C\u5168\u90E8\u6253\u51FA"
  - "\u6253\u51FA\u7684\u5B57\u6BCD\u724C\u7684\u6570\u91CF\u5373\u4E3A\u672C\u56DE\u5408\u83B7\u53D6\u7684\u5206\u6570"
  - "\u540C\u65F6\u83B7\u53D6\u4E0E\u5206\u6570\u7B49\u989D\u7684\u91D1\u5E01\uFF0C\u91D1\u5E01\u53EF\u4EE5\u5728\u5BF9\u5C40\u4E2D\u62BD\u53D6\u989D\u5916\u5361\u724C\uFF0C\u91D1\u5E01\u65E0\u7528\uFF0C\u4E00\u5B9A\u8981\u591A\u7528"
