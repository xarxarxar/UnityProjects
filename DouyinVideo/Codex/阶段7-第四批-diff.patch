+    /// <param name="state">需要恢复为 true 的状态字段。</param>
+    /// <param name="iconName">需要移除的状态图标名称。</param>
+    private void RestoreAbilityState(ref bool state, string iconName)
+    {
+        state = true;
+        RemoveEffectIcon(GetNegativeEffectParent(), iconName);
+    }
